# Maintainer: Sendem <18467008+sendement@users.noreply.github.com>
pkgname=dlss-manager
pkgver=0.2.0
pkgrel=1
pkgdesc="Scan Steam games, manage DLSS DLL versions, and install OptiScaler -- CLI + PySide6 GUI"
arch=('any')
url="https://github.com/sendement/dlss-manager"
license=('MIT')
depends=('python' 'python-pefile' 'python-platformdirs' 'pyside6' 'python-requests' '7zip')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-uv-build')
source=("$pkgname-$pkgver.tar.gz::https://github.com/sendement/dlss-manager/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1e6b0abd965ca01eec489b34d6296d6f13dfa4e6213f06be920be1edc1df8d41')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
